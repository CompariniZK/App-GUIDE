# Copie este arquivo para .env e preencha os valores.
# Copy this file to .env and fill in the values.
#
# ATENÇÃO / WARNING
# Tudo com o prefixo EXPO_PUBLIC_ é EMBUTIDO no bundle público do app —
# qualquer pessoa consegue ler no navegador. NUNCA coloque segredos aqui
# (chaves da Anthropic/Groq/Stripe, service_role do Supabase, etc.).
# Esses segredos vivem apenas no backend (variáveis do Railway).

# URL do backend (proxy da IA, cidades e Stripe)
EXPO_PUBLIC_API_URL=https://app-guide-production.up.railway.app

# Supabase — a anon key é pública por design (protegida por RLS)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx
